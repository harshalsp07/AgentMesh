# AgentMesh env — copy to .env and fill in. Hub reads these (or MESH_* vars).
# No key required for LAN default: board + collab work via hub op log + SSE.

# Optional: Liveblocks secret for cloud presence/storage on the tldraw board.
# Get one at https://liveblocks.io/dashboard/apikeys
# When empty, Board uses hub ops (LAN-fast, no vendor) then local-only.
LIVEBLOCKS_SECRET_KEY=

# Hub bind (use 0.0.0.0 for LAN, 127.0.0.1 for local-only)
MESH_HOST=127.0.0.1
PORT=7777

# Optional capability token (hub auth). Empty = open local dev.
MESH_TOKEN=
