# AgentMesh env — copy to .env and fill in, then export it (the hub does NOT
# read .env itself — use `set -a; . ./.env; set +a` or your process manager).
# All hub/CLI settings are MESH_* environment variables.

# ---- Hub bind -------------------------------------------------------------
# 127.0.0.1 = local only. 0.0.0.0 = reachable on the LAN.
# A non-loopback bind REQUIRES capability auth: the hub refuses to start
# (exit 78) unless keys exist, MESH_AUTH=1, or MESH_INSECURE=1 is set.
MESH_HOST=127.0.0.1
MESH_PORT=7777
MESH_DIR=.mesh

# Set to 1 to accept the risk of an open hub on a trusted LAN.
# The hub prints a loud warning in this mode. Never use it on an untrusted network.
MESH_INSECURE=

# ---- Capability auth ------------------------------------------------------
# `mesh up` creates .mesh/keys/hub.* and auth becomes enforced automatically.
# MESH_AUTH=1 forces enforcement even before keys exist.
MESH_AUTH=
# Per-actor capability token used by the CLI and the MCP bridge.
# Mint with: mesh token <actor>   (8 h TTL, revocable via jti)
MESH_TOKEN=

# ---- Durability -----------------------------------------------------------
# FULL = every event fsync'd before it is acknowledged (audit-grade, default).
# NORMAL = faster, but a power loss can lose the last few events and desync
# the SQLite log from the JSONL mirror.
MESH_SYNC=FULL

# ---- Protocol -------------------------------------------------------------
# Timeout for every hub call made by the MCP bridge (ms).
MESH_TIMEOUT_MS=15000

# ---- Fencing --------------------------------------------------------------
# Standby epoch. Promoted standbys must run a HIGHER epoch than the primary
# they replace; the hub refuses writes from a writer whose epoch is stale.
MESH_EPOCH=1

# ---- Snapshot backend -----------------------------------------------------
# auto | git | jj | sqlite | off
MESH_VCS=auto

# ---- Optional: cloud presence for the tldraw board ------------------------
# Get one at https://liveblocks.io/dashboard/apikeys
# When empty, the Board uses hub ops (LAN-fast, no vendor) then local-only.
LIVEBLOCKS_SECRET_KEY=

# ---- Optional: multi-repo mesh (one hub, several repos) -------------------
# MESH_REPOS=api:/srv/api,web:/srv/web
