#!/usr/bin/env node
// bin/mesh — production entrypoint. Forwards to src/mesh.mjs; `bridge` passes
// through to src/bridge.mjs so MCP clients can use `npx @harshalsp/agentmesh bridge`.
import { spawnSync } from 'node:child_process';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const argv = process.argv.slice(2);
const target = argv[0] === 'bridge' ? 'src/bridge.mjs' : 'src/mesh.mjs';
const r = spawnSync(process.execPath, [join(root, target), ...(target.endsWith('bridge.mjs') ? argv.slice(1) : argv)], { stdio: 'inherit' });
process.exit(r.status ?? 1);
